[configuration]

entry_symbol = "ocgcore_gd_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libocgcore_gd.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libocgcore_gd.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libocgcore_gd.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libocgcore_gd.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libocgcore_gd.macos.template_debug.framework"
macos.release = "res://bin/libocgcore_gd.macos.template_release.framework"
