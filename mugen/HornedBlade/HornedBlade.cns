; Horned Blade - constantes y estados (estilo MUGEN JUS)
; Habilidades inspiradas en Sven (Dota 2):
;   Storm Hammer  -> proyectil de rayo que aturde (estado 1000/1050/1100)
;   Great Cleave  -> tajos de barrido amplio y onda de hendidura (230/1200)
;   Warcry        -> +defensa, +velocidad y regeneracion 8 s (1300)
;   God's Strength-> daño x1.8 y aura roja 12 s (super 3000)
;
; Variables:
;   var(5)  dash aereo usado            var(10) tiempo restante de Warcry
;   var(11) tiempo de God's Strength    var(12) enfriamiento de Warcry
;   var(20) contador de tajos (ultimate) var(30) voz de KO reproducida
;   var(59) 1 = controlado por la CPU

[Data]
life = 1000
attack = 100
defence = 110
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 17
ground.front = 19
air.back = 14
air.front = 14
height = 72
attack.dist = 180
proj.attack.dist = 110
proj.doscale = 0
head.pos = 0, -96
mid.pos = 0, -62
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.3
walk.back = -2.1
run.fwd  = 5.2, 0
run.back = -4.6,-3.6
jump.neu = 0,-8.6
jump.back = -2.6
jump.fwd = 2.6
runjump.back = -2.6,-8.2
runjump.fwd = 4.2,-8.3
airjump.neu = 0,-7.8
airjump.back = -2.4
airjump.fwd = 2.4
air.gethit.groundrecover = -.15,-3.5
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-4.5
air.gethit.airrecover.back = -1
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -2
air.gethit.airrecover.down = 1.5

[Movement]
airjump.num = 1
airjump.height = 30
yaccel = .45
stand.friction = .85
crouch.friction = .82
stand.friction.threshold = 2
crouch.friction.threshold = .05
air.gethit.groundlevel = 25
air.gethit.groundrecover.ground.threshold = -20
air.gethit.groundrecover.groundlevel = 10
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 15
down.bounce.offset = 0, 20
down.bounce.yaccel = .4
down.bounce.groundlevel = 12
down.friction.threshold = .05

[Quotes]
victory1 = "Ninguna ley me detiene. Ni la tuya."
victory2 = "La Vigilia me expulso. Tu solo me hiciste sudar."
victory3 = "Siente el peso de la Hoja Proscrita."
victory4 = "Mi grito de guerra fue mas fuerte que tu valor."
victory5 = "Con la fuerza de los dioses, ninguna armadura resiste."

;===========================================================================
; ESTADO -2: efectos permanentes (se ejecuta siempre)
;===========================================================================
[Statedef -2]

[State -2, IA]
type = VarSet
trigger1 = 1
var(59) = AILevel > 0

[State -2, Warcry tiempo]
type = VarAdd
trigger1 = var(10) > 0
var(10) = -1

[State -2, God's Strength tiempo]
type = VarAdd
trigger1 = var(11) > 0
var(11) = -1

[State -2, Warcry enfriamiento]
type = VarAdd
trigger1 = var(12) > 0
var(12) = -1

[State -2, dash aereo reset]
type = VarSet
trigger1 = statetype != A
var(5) = 0

; ---- Warcry: +45% defensa, regeneracion y velocidad
[State -2, Warcry defensa]
type = DefenceMulSet
trigger1 = 1
value = ifelse(var(10) > 0, 1.45, 1)

[State -2, Warcry curacion]
type = LifeAdd
trigger1 = var(10) > 0 && alive
trigger1 = var(10) % 6 = 0
value = 1

[State -2, Warcry velocidad adelante]
type = PosAdd
trigger1 = var(10) > 0
trigger1 = stateno = 20 || stateno = 100
x = 0.9

[State -2, Warcry velocidad atras]
type = PosAdd
trigger1 = var(10) > 0
trigger1 = stateno = 21
x = -0.6

[State -2, Warcry fin escudo]
type = RemoveExplod
trigger1 = var(10) = 0 && NumExplod(6310) > 0
id = 6310

; ---- God's Strength: daño x1.8, brillo rojo
[State -2, God's Strength ataque]
type = AttackMulSet
trigger1 = 1
value = ifelse(var(11) > 0, 1.8, 1)

[State -2, God's Strength brillo]
type = PalFX
trigger1 = var(11) > 0
time = 2
add = 70, -10, -30
mul = 256, 200, 190
sinadd = 40, 0, 0, 30

[State -2, God's Strength fin aura]
type = RemoveExplod
trigger1 = var(11) = 0 && NumExplod(6400) > 0
id = 6400

[State -2, God's Strength chispa roja]
type = Explod
trigger1 = var(11) > 0 && MoveHit = 1
anim = 6040
postype = p2
pos = 0, -60
sprpriority = 4
ownpal = 1
trans = add
removetime = -2

; ---- Storm Hammer: aturdimiento electrico sobre el rival
[State -2, Storm Hammer aturdido]
type = Explod
trigger1 = ProjHitTime(1000) = 0
trigger2 = ProjHitTime(3200) = 0
anim = 6130
postype = p2
pos = 0, 0
bindtime = 45
removetime = 45
sprpriority = 4
ownpal = 1
trans = add

[State -2, Storm Hammer trueno]
type = EnvShake
trigger1 = ProjHitTime(1000) = 0
trigger2 = ProjHitTime(3200) = 0
time = 12
freq = 70
ampl = 3

; ---- limpieza
[State -2, quitar aura de carga]
type = RemoveExplod
trigger1 = stateno != 700 && NumExplod(700) > 0
id = 700

; ---- voces
[State -2, voz dolor]
type = PlaySnd
trigger1 = alive && time = 1 && random < 350
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5030
value = 10, 7
channel = 0

[State -2, voz KO]
type = PlaySnd
trigger1 = !alive && var(30) = 0
value = 10, 8
channel = 0

[State -2, voz KO marca]
type = VarSet
trigger1 = !alive && var(30) = 0
var(30) = 1

